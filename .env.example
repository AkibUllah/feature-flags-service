APP_ENV=development
LOG_LEVEL=INFO

# SQLite for local dev; PostgreSQL in docker-compose
DATABASE_URL=sqlite:///./flags.db
# DATABASE_URL=postgresql+psycopg://flags:flags@db:5432/flags

# Redis for the payload cache, usage counters and cross-instance change notifications.
# Leave empty to run fully in memory (single instance).
REDIS_URL=
# REDIS_URL=redis://redis:6379/0

# Admin API key required on management endpoints (X-API-Key). Leave empty to disable auth locally.
ADMIN_API_KEY=change-me

# Seconds between scheduled-change sweeps; 0 disables the background scheduler
SCHEDULER_INTERVAL_SECONDS=15
# SSE keep-alive comment interval
SSE_HEARTBEAT_SECONDS=15
# Outgoing webhook timeout
WEBHOOK_TIMEOUT_SECONDS=5
